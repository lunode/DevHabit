services:
  devhabit.api:
    environment:
      - ASPNETCORE_ENVIRONMENT=Development
      - ASPNETCORE_HTTP_PORTS=8080
      - ASPNETCORE_HTTPS_PORTS=8081
    volumes:
      # for Windows ${APP_DATA} => C:\Users\{UserName}\AppData\Roaming
      # - ${APP_DATA}/Microsoft/UserSecrets:/home/app/.microsoft/usersecrets
      # - ${APP_DATA}/ASP.NET/Https:/home/app/.aspnet/Https:ro

      # for Macos
      - ~/.microsoft/usersecrets:/home/app/.microsoft/usersecrets:ro
      - ~/.aspnet/https:/home/app/.aspnet/https:ro
